<?xml version="1.0" encoding="utf-8"?>
<!-- Écran unique du convertisseur :
     - en haut (45 %) : zone d'affichage turquoise (titre, devises, montants, boutons) ;
     - en bas : clavier numérique personnalisé (TableLayout 4 x 3). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_clavier"
    tools:context=".MainActivity">

    <!-- Limite entre la zone d'affichage et le clavier : 45 % de la hauteur -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideZoneAffichage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.45" />

    <!-- Fond bleu turquoise uni de la zone d'affichage -->
    <View
        android:id="@+id/vFondAffichage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/turquoise_fond"
        app:layout_constraintBottom_toTopOf="@id/guideZoneAffichage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ===================== ZONE D'AFFICHAGE ===================== -->

    <!-- Titre centré (tête de la chaîne verticale de la zone du haut) -->
    <TextView
        android:id="@+id/tvTitre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/marge_haut_titre"
        android:text="@string/titre"
        android:textColor="@color/blanc"
        android:textSize="@dimen/taille_titre"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tvMontant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside" />

    <!-- Bonus : bascule taux fixes / taux réels (API) -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swTauxReels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/marge_petite"
        android:text="@string/taux_reels"
        android:textColor="@color/blanc"
        android:textSize="@dimen/taille_switch"
        app:layout_constraintBottom_toBottomOf="@id/tvTitre"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvTitre" />

    <!-- Devise source -->
    <Spinner
        android:id="@+id/spDeviseSource"
        android:layout_width="@dimen/largeur_spinner"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/marge_ecran"
        android:backgroundTint="@color/blanc"
        android:contentDescription="@string/desc_devise_source"
        app:layout_constraintBottom_toBottomOf="@id/tvMontant"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvMontant" />

    <!-- Montant saisi : TextView (saisie uniquement par le clavier de l'application) -->
    <TextView
        android:id="@+id/tvMontant"
        android:layout_width="0dp"
        android:layout_height="@dimen/hauteur_montant"
        android:layout_marginStart="@dimen/marge_montant"
        android:layout_marginEnd="@dimen/marge_ecran"
        android:background="@drawable/fond_souligne"
        android:gravity="end|center_vertical"
        android:maxLines="1"
        android:text="@string/montant_initial"
        android:textColor="@color/blanc"
        android:textSize="@dimen/taille_montant"
        app:autoSizeMaxTextSize="@dimen/taille_montant"
        app:autoSizeMinTextSize="@dimen/taille_montant_min"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@id/btnInverser"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/spDeviseSource"
        app:layout_constraintTop_toBottomOf="@id/tvTitre" />

    <!-- Bouton d'inversion des deux devises -->
    <ImageButton
        android:id="@+id/btnInverser"
        android:layout_width="@dimen/taille_inverser"
        android:layout_height="@dimen/taille_inverser"
        android:layout_marginStart="@dimen/marge_ecran"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/desc_inverser"
        android:src="@drawable/ic_inverser"
        app:layout_constraintBottom_toTopOf="@id/tvResultat"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMontant" />

    <!-- Devise cible -->
    <Spinner
        android:id="@+id/spDeviseCible"
        android:layout_width="@dimen/largeur_spinner"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/marge_ecran"
        android:backgroundTint="@color/blanc"
        android:contentDescription="@string/desc_devise_cible"
        app:layout_constraintBottom_toBottomOf="@id/tvResultat"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvResultat" />

    <!-- Résultat de la conversion -->
    <TextView
        android:id="@+id/tvResultat"
        android:layout_width="0dp"
        android:layout_height="@dimen/hauteur_montant"
        android:layout_marginStart="@dimen/marge_montant"
        android:layout_marginEnd="@dimen/marge_ecran"
        android:background="@drawable/fond_souligne"
        android:gravity="end|center_vertical"
        android:maxLines="1"
        android:textColor="@color/blanc"
        android:textSize="@dimen/taille_montant"
        app:autoSizeMaxTextSize="@dimen/taille_montant"
        app:autoSizeMinTextSize="@dimen/taille_montant_min"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@id/btnConvertir"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/spDeviseCible"
        app:layout_constraintTop_toBottomOf="@id/btnInverser" />

    <!-- Bouton « Convertir » (fin de la chaîne verticale) -->
    <Button
        android:id="@+id/btnConvertir"
        android:layout_width="@dimen/largeur_convertir"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/marge_bas_convertir"
        android:text="@string/bouton_convertir"
        android:textAllCaps="true"
        android:textColor="@color/turquoise_touche"
        android:textStyle="bold"
        app:backgroundTint="@color/blanc"
        app:cornerRadius="@dimen/rayon_convertir"
        app:layout_constraintBottom_toTopOf="@id/guideZoneAffichage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvResultat" />

    <!-- ===================== CLAVIER NUMÉRIQUE ===================== -->

    <!-- TableLayout 4 lignes x 3 colonnes, dans le ConstraintLayout principal -->
    <TableLayout
        android:id="@+id/tlClavier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/fond_clavier"
        android:padding="@dimen/marge_petite"
        android:stretchColumns="*"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guideZoneAffichage">

        <!-- Ligne 1 -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn7"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_7"
                android:textColor="@color/turquoise_touche"
                android:textSize="@dimen/taille_touche"
                app:backgroundTint="@color/transparent" />

            <Button
                android:id="@+id/btn8"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_8"
                android:textColor="@color/turquoise_touche"
                android:textSize="@dimen/taille_touche"
                app:backgroundTint="@color/transparent" />

            <Button
                android:id="@+id/btn9"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_9"
                android:textColor="@color/turquoise_touche"
                android:textSize="@dimen/taille_touche"
                app:backgroundTint="@color/transparent" />
        </TableRow>

        <!-- Ligne 2 -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn4"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_4"
                android:textColor="@color/turquoise_touche"
                android:textSize="@dimen/taille_touche"
                app:backgroundTint="@color/transparent" />

            <Button
                android:id="@+id/btn5"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_5"
                android:textColor="@color/turquoise_touche"
                android:textSize="@dimen/taille_touche"
                app:backgroundTint="@color/transparent" />

            <Button
                android:id="@+id/btn6"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_6"
                android:textColor="@color/turquoise_touche"
                android:textSize="@dimen/taille_touche"
                app:backgroundTint="@color/transparent" />
        </TableRow>

        <!-- Ligne 3 -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn1"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_1"
                android:textColor="@color/turquoise_touche"
                android:textSize="@dimen/taille_touche"
                app:backgroundTint="@color/transparent" />

            <Button
                android:id="@+id/btn2"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_2"
                android:textColor="@color/turquoise_touche"
                android:textSize="@dimen/taille_touche"
                app:backgroundTint="@color/transparent" />

            <Button
                android:id="@+id/btn3"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_3"
                android:textColor="@color/turquoise_touche"
                android:textSize="@dimen/taille_touche"
                app:backgroundTint="@color/transparent" />
        </TableRow>

        <!-- Ligne 4 -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btnEffacer"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_effacer"
                android:textColor="@color/rouge_effacer"
                android:textSize="@dimen/taille_touche"
                app:backgroundTint="@color/transparent" />

            <Button
                android:id="@+id/btn0"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_0"
                android:textColor="@color/turquoise_touche"
                android:textSize="@dimen/taille_touche"
                app:backgroundTint="@color/transparent" />

            <Button
                android:id="@+id/btnPoint"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_point"
                android:textColor="@color/turquoise_touche"
                android:textSize="@dimen/taille_touche"
                app:backgroundTint="@color/transparent" />
        </TableRow>
    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
